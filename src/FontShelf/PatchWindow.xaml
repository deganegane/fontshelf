<Window x:Class="FontShelf.PatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FontShelf"
        Title="Dodaj hrvatske znakove" Width="1220" Height="800" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Height" Value="34"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>

        <!-- zaglavlje -->
        <StackPanel x:Name="NavPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Visibility="Collapsed">
            <Button x:Name="PrevButton" Style="{StaticResource ActionButton}" Content="‹  Prethodni" Height="36"
                    Padding="14,0" Margin="0" ToolTip="Prethodni font (Alt + ←)" Click="Prev_Click"/>
            <TextBlock x:Name="NavText" VerticalAlignment="Center" Margin="14,0" MinWidth="64" TextAlignment="Center"
                       Foreground="{DynamicResource SubTextBrush}"/>
            <Button x:Name="NextButton" Style="{StaticResource ActionButton}" Content="Sljedeći  ›" Height="36"
                    Padding="14,0" Margin="0" ToolTip="Sljedeći font (Alt + →)" Click="Next_Click"/>
        </StackPanel>
        <StackPanel x:Name="HeaderPanel" Margin="0,0,24,0">
            <TextBlock x:Name="TitleText" Text="Dodaj hrvatske znakove" FontFamily="{StaticResource DisplayFont}"
                       FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="InfoText" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- pregled -->
        <Border Grid.Row="1" Margin="0,18,24,0" Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="28,20">
            <DockPanel>
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                <TextBlock Text="Veličina prikaza" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{DynamicResource SubTextBrush}"/>
                <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="0.4" Maximum="4" Value="1" IsMoveToPointEnabled="True" ValueChanged="Zoom_Changed"/>
                <TextBlock x:Name="ZoomVal" Grid.Column="2" Text="100%" Style="{StaticResource RowValue}"/>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <local:GlyphPreview x:Name="PreviewBig" Text="čćšžđ ČĆŠŽĐ" FontSize="84"/>
                    <local:GlyphPreview x:Name="PreviewWords" Text="Čakovec Đakovo Šibenik Žminj Ćićarija" FontSize="40" Margin="0,6,0,0"/>
                    <local:GlyphPreview x:Name="PreviewSmall" Text="Gojazni đačić s biciklom drži hmelj i finu vatu u džepu nošnje. Šuma, žaba, čaša, kuća, đon."
                                        FontSize="26" Margin="0,10,0,0"/>
                    <local:GlyphPreview x:Name="PreviewCaps" Text="ŠĐČĆŽ ČAŠA ŽLICA ĆUP ĐAK ŠKOLA" FontSize="26" Margin="0,8,0,0" BrushKey="BodyTextBrush"/>
                    <TextBlock Foreground="{DynamicResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"
                               Text="Pregled koristi samo znakove ovog fonta. Narančasti okvir znači da znak još ne postoji."/>
                </StackPanel>
            </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- postavke -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <StackPanel x:Name="ControlsPanel" Margin="0,0,14,0">
                <TextBlock Text="Položaj kvačice i akcenta" Style="{StaticResource DetailTitle}" Margin="0,0,0,6"/>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Visina" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="GapSlider" Grid.Column="1" Minimum="-0.12" Maximum="0.25" Value="0" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="GapVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Lijevo / desno" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="AccXSlider" Grid.Column="1" Minimum="-0.2" Maximum="0.2" Value="0" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="AccXVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>

                <!-- kvačica -->
                <TextBlock Text="Kvačica (č š ž)" Style="{StaticResource DetailTitle}" Margin="0,20,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Width="46" Height="40" CornerRadius="8" Background="{DynamicResource CardBrush}">
                        <TextBlock x:Name="CaronGlyphText" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="CaronGlyphLabel" Text="Automatski" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="86"
                               Foreground="{DynamicResource SubTextBrush}"/>
                    <Button Style="{StaticResource ActionButton}" Content="Odaberi znak…" Height="34" Padding="14,0" Margin="8,0,0,0"
                            Tag="Caron" Click="PickGlyph_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Automatski" Height="34" Padding="10,0" Margin="6,0,0,0"
                            Tag="Caron" Click="ClearGlyph_Click" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Veličina" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="CaronSSlider" Grid.Column="1" Minimum="0.3" Maximum="2.5" Value="1" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="CaronSVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Širina (rastezanje)" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="CaronWSlider" Grid.Column="1" Minimum="0.3" Maximum="2.5" Value="1" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="CaronWVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Debljina" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="CaronTSlider" Grid.Column="1" Minimum="-0.05" Maximum="0.1" Value="0" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="CaronTVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Zakret" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="CaronRSlider" Grid.Column="1" Minimum="-90" Maximum="90" Value="0" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="CaronRVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <CheckBox x:Name="CaronFlipCheck" Style="{StaticResource Switch}" Content="Okreni naopako (npr. ^ postaje ˇ)"
                          Checked="Check_Changed" Unchecked="Check_Changed"/>

                <!-- akcent -->
                <TextBlock Text="Akcent (ć)" Style="{StaticResource DetailTitle}" Margin="0,20,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Width="46" Height="40" CornerRadius="8" Background="{DynamicResource CardBrush}">
                        <TextBlock x:Name="AcuteGlyphText" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="AcuteGlyphLabel" Text="Automatski" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="86"
                               Foreground="{DynamicResource SubTextBrush}"/>
                    <Button Style="{StaticResource ActionButton}" Content="Odaberi znak…" Height="34" Padding="14,0" Margin="8,0,0,0"
                            Tag="Acute" Click="PickGlyph_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Automatski" Height="34" Padding="10,0" Margin="6,0,0,0"
                            Tag="Acute" Click="ClearGlyph_Click" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Veličina" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="AcuteSSlider" Grid.Column="1" Minimum="0.3" Maximum="2.5" Value="1" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="AcuteSVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Širina (rastezanje)" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="AcuteWSlider" Grid.Column="1" Minimum="0.3" Maximum="2.5" Value="1" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="AcuteWVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Debljina" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="AcuteTSlider" Grid.Column="1" Minimum="-0.05" Maximum="0.1" Value="0" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="AcuteTVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Zakret" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="AcuteRSlider" Grid.Column="1" Minimum="-90" Maximum="90" Value="0" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="AcuteRVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <CheckBox x:Name="AcuteFlipCheck" Style="{StaticResource Switch}" Content="Okreni naopako"
                          Checked="Check_Changed" Unchecked="Check_Changed"/>

                <!-- crtica -->
                <TextBlock Text="Crtica na đ i Đ" Style="{StaticResource DetailTitle}" Margin="0,20,0,6"/>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Visina na malom đ" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="BarYSlider" Grid.Column="1" Minimum="-0.4" Maximum="0.4" Value="0" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="BarYVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Visina na velikom Đ" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="BarYUSlider" Grid.Column="1" Minimum="-0.4" Maximum="0.4" Value="0" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="BarYUVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Lijevo / desno" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="BarXSlider" Grid.Column="1" Minimum="-0.15" Maximum="0.15" Value="0" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="BarXVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Širina" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="BarWSlider" Grid.Column="1" Minimum="0.4" Maximum="2.2" Value="1" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="BarWVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Debljina" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="BarTSlider" Grid.Column="1" Minimum="0.4" Maximum="1.9" Value="1" IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="BarTVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <CheckBox x:Name="OwnDCheck" Style="{StaticResource Switch}"
                          Content="Veliko Đ složi od D i crtice (ne koristi gotovi Ð)"
                          Checked="Check_Changed" Unchecked="Check_Changed"/>

                <!-- pojedino slovo -->
                <TextBlock Text="Fino podešavanje jednog slova" Style="{StaticResource DetailTitle}" Margin="0,20,0,4"/>
                <TextBlock Foreground="{DynamicResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Odaberi slovo pa pomakni samo njegovu kvačicu, akcent ili crticu. Dodaje se na opće postavke iznad."/>
                <WrapPanel x:Name="PerLetterPanel" Margin="0,0,0,6">
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="PerGlyph" Content="č" Tag="č" MinWidth="36" FontSize="15" IsChecked="True" Checked="PerLetter_Checked"/>
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="PerGlyph" Content="ć" Tag="ć" MinWidth="36" FontSize="15" Checked="PerLetter_Checked"/>
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="PerGlyph" Content="š" Tag="š" MinWidth="36" FontSize="15" Checked="PerLetter_Checked"/>
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="PerGlyph" Content="ž" Tag="ž" MinWidth="36" FontSize="15" Checked="PerLetter_Checked"/>
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="PerGlyph" Content="đ" Tag="đ" MinWidth="36" FontSize="15" Checked="PerLetter_Checked"/>
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="PerGlyph" Content="Č" Tag="Č" MinWidth="36" FontSize="15" Checked="PerLetter_Checked"/>
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="PerGlyph" Content="Ć" Tag="Ć" MinWidth="36" FontSize="15" Checked="PerLetter_Checked"/>
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="PerGlyph" Content="Š" Tag="Š" MinWidth="36" FontSize="15" Checked="PerLetter_Checked"/>
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="PerGlyph" Content="Ž" Tag="Ž" MinWidth="36" FontSize="15" Checked="PerLetter_Checked"/>
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="PerGlyph" Content="Đ" Tag="Đ" MinWidth="36" FontSize="15" Checked="PerLetter_Checked"/>
                </WrapPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Lijevo / desno" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="PerXSlider" Grid.Column="1" Minimum="-0.3" Maximum="0.3" Value="0" IsMoveToPointEnabled="True" ValueChanged="PerLetter_Changed"/>
                    <TextBlock x:Name="PerXVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Gore / dolje" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="PerYSlider" Grid.Column="1" Minimum="-0.3" Maximum="0.3" Value="0" IsMoveToPointEnabled="True" ValueChanged="PerLetter_Changed"/>
                    <TextBlock x:Name="PerYVal" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>

                <TextBlock Foreground="{DynamicResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                           Text="Original se ne mijenja — sprema se kopija s „HR” u imenu i dodaje u biblioteku."/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Vrati zadano"
                    Foreground="{DynamicResource SubTextBrush}" Click="Reset_Click"/>
            <CheckBox x:Name="IncludeCheck" DockPanel.Dock="Left" Style="{StaticResource Switch}" Content="Uključi ovaj font"
                      IsChecked="True" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                      Checked="Include_Changed" Unchecked="Include_Changed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ActionButton}" Content="Zatvori" Height="40" Padding="18,0" Margin="0,0,10,0"
                        IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="SaveAllButton" Style="{StaticResource ActionButton}" Height="40" Padding="18,0" Margin="0,0,10,0"
                        Content="Spremi sve" Click="SaveAll_Click" Visibility="Collapsed"/>
                <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Height="40" Padding="18,0" Margin="0"
                        Content="Spremi ovaj font" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
