<Window x:Class="FontShelf.PatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj hrvatske znakove" Width="840" Height="860" MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="NavPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Panel.ZIndex="2" Visibility="Collapsed">
            <Button x:Name="PrevButton" Style="{StaticResource ActionButton}" Content="‹" FontSize="18" Width="40" Height="36"
                    Padding="0" Margin="0" ToolTip="Prethodni font (Alt + ←)" Click="Prev_Click"/>
            <TextBlock x:Name="NavText" VerticalAlignment="Center" Margin="14,0" MinWidth="64" TextAlignment="Center"
                       Foreground="{DynamicResource SubTextBrush}"/>
            <Button x:Name="NextButton" Style="{StaticResource ActionButton}" Content="›" FontSize="18" Width="40" Height="36"
                    Padding="0" Margin="0" ToolTip="Sljedeći font (Alt + →)" Click="Next_Click"/>
        </StackPanel>
        <StackPanel x:Name="HeaderPanel">
            <TextBlock x:Name="TitleText" Text="Dodaj hrvatske znakove" FontFamily="{StaticResource DisplayFont}"
                       FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="InfoText" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="28,22">
            <StackPanel>
                <TextBlock x:Name="PreviewBig" Text="čćšžđ ČĆŠŽĐ" FontSize="68" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PreviewSmall" Text="Gojazni đačić s biciklom drži hmelj i finu vatu u džepu nošnje."
                           FontSize="26" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock x:Name="PreviewCaps" Text="ŠĐČĆŽ · Čakovec, Đakovo, Šibenik, Žminj, Ćićarija"
                           FontSize="22" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource BodyTextBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <StackPanel x:Name="ControlsPanel">
                <TextBlock Text="Kvačice i akcenti" Style="{StaticResource DetailTitle}" Margin="0,4,0,8"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Visina (razmak od slova)" VerticalAlignment="Center"/>
                    <Slider x:Name="GapSlider" Grid.Column="1" Minimum="-0.12" Maximum="0.25" Value="0" IsMoveToPointEnabled="True"
                            ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="GapVal" Grid.Column="2" TextAlignment="Right" Foreground="{DynamicResource SubTextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="Pomak lijevo / desno" VerticalAlignment="Center"/>
                    <Slider x:Name="AccXSlider" Grid.Row="1" Grid.Column="1" Minimum="-0.2" Maximum="0.2" Value="0"
                            IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="AccXVal" Grid.Row="1" Grid.Column="2" TextAlignment="Right"
                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="Crtica na đ i Đ" Style="{StaticResource DetailTitle}" Margin="0,18,0,8"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Visina na malom đ" VerticalAlignment="Center"/>
                    <Slider x:Name="BarYSlider" Grid.Column="1" Minimum="-0.4" Maximum="0.4" Value="0" IsMoveToPointEnabled="True"
                            ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="BarYVal" Grid.Column="2" TextAlignment="Right" Foreground="{DynamicResource SubTextBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="4" Text="Visina na velikom Đ" VerticalAlignment="Center"/>
                    <Slider x:Name="BarYUSlider" Grid.Row="4" Grid.Column="1" Minimum="-0.4" Maximum="0.4" Value="0"
                            IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="BarYUVal" Grid.Row="4" Grid.Column="2" TextAlignment="Right"
                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    <CheckBox x:Name="OwnDCheck" Grid.Row="5" Grid.ColumnSpan="3" Style="{StaticResource Switch}" VerticalAlignment="Center"
                              Content="Veliko Đ složi od D i crtice (umjesto gotovog znaka Ð iz fonta)"
                              Checked="Check_Changed" Unchecked="Check_Changed"/>

                    <TextBlock Grid.Row="1" Text="Pomak lijevo / desno" VerticalAlignment="Center"/>
                    <Slider x:Name="BarXSlider" Grid.Row="1" Grid.Column="1" Minimum="-0.15" Maximum="0.15" Value="0"
                            IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="BarXVal" Grid.Row="1" Grid.Column="2" TextAlignment="Right"
                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Text="Širina" VerticalAlignment="Center"/>
                    <Slider x:Name="BarWSlider" Grid.Row="2" Grid.Column="1" Minimum="0.5" Maximum="1.7" Value="1"
                            IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="BarWVal" Grid.Row="2" Grid.Column="2" TextAlignment="Right"
                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="3" Text="Debljina" VerticalAlignment="Center"/>
                    <Slider x:Name="BarTSlider" Grid.Row="3" Grid.Column="1" Minimum="0.5" Maximum="1.8" Value="1"
                            IsMoveToPointEnabled="True" ValueChanged="Option_Changed"/>
                    <TextBlock x:Name="BarTVal" Grid.Row="3" Grid.Column="2" TextAlignment="Right"
                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Foreground="{DynamicResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Novi znakovi slažu se od dijelova koji u fontu već postoje (slovo + kvačica, akcent ili crtica). Original se ne mijenja — sprema se kopija s „HR” u imenu i dodaje u biblioteku."/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Vrati zadano"
                    Foreground="{DynamicResource SubTextBrush}" Click="Reset_Click"/>
            <CheckBox x:Name="IncludeCheck" DockPanel.Dock="Left" Style="{StaticResource Switch}" Content="Uključi ovaj font"
                      IsChecked="True" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                      Checked="Include_Changed" Unchecked="Include_Changed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ActionButton}" Content="Odustani" Height="40" Padding="18,0" Margin="0,0,10,0"
                        IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Height="40" Padding="18,0" Margin="0"
                        Content="Spremi" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
