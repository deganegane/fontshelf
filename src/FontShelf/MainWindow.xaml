<Window x:Class="FontShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FontShelf.Converters"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FontShelf" Height="880" Width="1480" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        SourceInitialized="Window_SourceInitialized">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullVis"/>
        <conv:NullToVisibilityConverter x:Key="NullVisInv" Invert="True"/>
        <conv:ZeroToVisibilityConverter x:Key="ZeroVis"/>

        <Style x:Key="GlyphCell" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <Style x:Key="PlainRowItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridCellButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="200" Height="150" Margin="0,0,12,12" CornerRadius="10"
                                Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stavka u bočnoj traci (biblioteka) -->
        <DataTemplate x:Key="LibraryEntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{DynamicResource SubTextBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TagEntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="2">
                    <TextBlock x:Name="Cnt" Text="{Binding Count}" Foreground="{DynamicResource SubTextBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <StackPanel x:Name="Acts" Orientation="Horizontal" Visibility="Collapsed" Margin="0,-4">
                        <Button Style="{StaticResource IconButton}" Content="&#xEDE1;" Padding="4"
                                ToolTip="Izvezi sve fontove s ovim tagom u mapu" Click="ExportTag_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Padding="4"
                                ToolTip="Obriši tag" Click="DeleteTag_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Cnt" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Acts" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="FolderEntryTemplate">
            <Grid ToolTip="{Binding Value}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="2">
                    <TextBlock x:Name="Cnt" Text="{Binding Count}" Foreground="{DynamicResource SubTextBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <StackPanel x:Name="Acts" Orientation="Horizontal" Visibility="Collapsed" Margin="0,-4">
                        <Button Style="{StaticResource IconButton}" Content="&#xE945;" Padding="4"
                                ToolTip="Aktiviraj / deaktiviraj sve fontove iz mape" Click="ToggleFolderActivation_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" Padding="4"
                                ToolTip="Ukloni mapu iz biblioteke" Click="RemoveFolder_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Cnt" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Acts" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Značke fonta -->
        <DataTemplate x:Key="BadgesTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Badge}" Visibility="{Binding IsFromFolder, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="iz mape" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                </Border>
                <Border Style="{StaticResource Badge}" Visibility="{Binding HasActivationLabel, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding ActivationLabel}" FontSize="11" Foreground="{DynamicResource GoodBrush}"/>
                </Border>
                <Border Style="{StaticResource Badge}" Visibility="{Binding IsVariable, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="varijabilni" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
                <Border Style="{StaticResource Badge}" Visibility="{Binding IsMonoBadge, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="mono" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                </Border>
                <Border Style="{StaticResource Badge}" Visibility="{Binding IsDuplicate, Converter={StaticResource BoolVis}}"
                        ToolTip="Font s istim imenom postoji više puta">
                    <TextBlock Text="duplikat" FontSize="11" Foreground="{DynamicResource WarnBrush}"/>
                </Border>
                <Border Style="{StaticResource Badge}" Visibility="{Binding MissingCroatian, Converter={StaticResource BoolVis}}"
                        ToolTip="Font nema sva slova č ć đ š ž">
                    <TextBlock Text="bez čćđšž" FontSize="11" Foreground="{DynamicResource WarnBrush}"/>
                </Border>
                <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center" Margin="4,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Kartica fonta -->
        <DataTemplate x:Key="FontCardTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,-4,0,0">
                        <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE8A9;" ToolTip="Dodaj u usporedbu"
                                      IsChecked="{Binding IsComparing}" Click="CompareToggle_Click"/>
                        <ToggleButton Style="{StaticResource StarToggle}" ToolTip="Favorit"
                                      IsChecked="{Binding IsFavorite}" Click="FavoriteToggle_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding StyleCountText}" Foreground="{DynamicResource SubTextBrush}"
                                   FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BadgesTemplate}"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Grid.Row="1" Margin="0,4,6,0"
                           Text="{Binding DataContext.CardText, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="{Binding DataContext.CardFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           TextWrapping="{Binding DataContext.CardWrap, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="{Binding Family}" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="430"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== BOČNA TRAKA ===================== -->
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,18,12,4">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="Aa" FontFamily="Georgia" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="FontShelf" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0">
                    <StackPanel>
                        <TextBlock Text="BIBLIOTEKA" Style="{StaticResource SectionTitle}"/>
                        <ListBox x:Name="LibraryList" Style="{StaticResource PlainList}"
                                 ItemsSource="{Binding LibraryEntries}" ItemTemplate="{StaticResource LibraryEntryTemplate}"
                                 ItemContainerStyle="{StaticResource SidebarItem}"
                                 SelectionChanged="Sidebar_SelectionChanged"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 PreviewMouseWheel="Sidebar_PreviewMouseWheel"/>

                        <TextBlock Text="TAGOVI" Style="{StaticResource SectionTitle}"/>
                        <ListBox x:Name="TagList" Style="{StaticResource PlainList}"
                                 ItemsSource="{Binding TagEntries}" ItemTemplate="{StaticResource TagEntryTemplate}"
                                 ItemContainerStyle="{StaticResource SidebarItem}"
                                 SelectionChanged="Sidebar_SelectionChanged"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 PreviewMouseWheel="Sidebar_PreviewMouseWheel"/>
                        <TextBox x:Name="NewTagBox" Tag="+ Novi tag (Enter)" Margin="2,4,2,0" Padding="8,5"
                                 KeyDown="NewTagBox_KeyDown"/>

                        <Grid Margin="0,0,2,0">
                            <TextBlock Text="MAPE" Style="{StaticResource SectionTitle}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE710;" HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom" Margin="0,0,0,2" ToolTip="Dodaj mapu s fontovima"
                                    Click="AddFolder_Click"/>
                        </Grid>
                        <ListBox x:Name="FolderList" Style="{StaticResource PlainList}"
                                 ItemsSource="{Binding FolderEntries}" ItemTemplate="{StaticResource FolderEntryTemplate}"
                                 ItemContainerStyle="{StaticResource SidebarItem}"
                                 SelectionChanged="Sidebar_SelectionChanged"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 PreviewMouseWheel="Sidebar_PreviewMouseWheel"/>
                        <StackPanel Visibility="{Binding HasFolders, Converter={StaticResource BoolVisInv}}" Margin="10,2,6,0">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}" FontSize="12"
                                       Text="Dodaj mapu s fontovima da ih pregledaš i aktiviraš bez instalacije. Možeš i povući mapu ili fontove u prozor."/>
                            <Button Style="{StaticResource ActionButton}" Content="Dodaj mapu…" HorizontalAlignment="Left"
                                    Margin="0,10,0,0" Click="AddFolder_Click"/>
                        </StackPanel>

                        <TextBlock Text="POSTAVKE" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Style="{StaticResource Switch}" Content="Sakrij sistemske fontove"
                                  IsChecked="{Binding HideSystemFonts}"
                                  ToolTip="Prikazuj samo fontove iz tvojih mapa (u favoritima i tagovima ostaju vidljivi)"/>
                        <CheckBox Style="{StaticResource Switch}" Content="Privremena aktivacija"
                                  IsChecked="{Binding TemporaryActivation}"
                                  ToolTip="Aktivirani fontovi se automatski deaktiviraju kad zatvoriš FontShelf"/>
                        <CheckBox Style="{StaticResource Switch}" Content="Svijetla tema" IsChecked="{Binding LightTheme}"/>
                        <Border Height="20"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== GLAVNI DIO ===================== -->
        <Grid Grid.Column="1" Margin="24,18,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="3"
                        VerticalAlignment="Center" Visibility="{Binding IsLibraryMode, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Popis" IsChecked="{Binding IsListMode}"/>
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Mreža" IsChecked="{Binding IsGridMode}"/>
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Tablica" IsChecked="{Binding IsTableMode}"/>
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{Binding CompareTabText}"
                                     IsChecked="{Binding IsCompareMode}"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource SubTextBrush}" FontSize="13"
                               Margin="12,0,0,4" VerticalAlignment="Bottom"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,16,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Tag="Pretraži fontove i tagove  (Ctrl+F)" Padding="30,7,8,7"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" IsHitTestVisible="False"
                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="11,0,0,0"/>
                </Grid>
                <TextBox Grid.Column="1" Margin="10,0" Tag="Upiši svoj tekst za pregled…"
                         Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8E9;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    <Slider Width="150" Minimum="10" Maximum="160" Margin="8,0" VerticalAlignment="Center"
                            Value="{Binding PreviewSize}" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="8"/>
                    <TextBlock Text="{Binding PreviewSizeText}" Width="44" Foreground="{DynamicResource SubTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Druga traka: vrsta pregleda + sortiranje -->
            <DockPanel Grid.Row="2" Margin="0,10,10,12" Visibility="{Binding IsLibraryMode, Converter={StaticResource BoolVis}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="Sort_Click"
                        ToolTip="Klikni za promjenu redoslijeda" Foreground="{DynamicResource SubTextBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SortText}"/>
                    </StackPanel>
                </Button>
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Redak" IsChecked="{Binding IsLinePreview}"/>
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Odlomak" IsChecked="{Binding IsParagraphPreview}"/>
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Abeceda" IsChecked="{Binding IsAlphabetPreview}"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Popis fontova -->
            <Grid Grid.Row="3" Visibility="{Binding ShowList, Converter={StaticResource BoolVis}}">
                <ListBox x:Name="FontList" Style="{StaticResource PlainList}"
                         ItemsSource="{Binding FontsView}" SelectedItem="{Binding SelectedFont}"
                         ItemTemplate="{StaticResource FontCardTemplate}"
                         ItemContainerStyle="{StaticResource FontCardItem}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"/>
            </Grid>

            <!-- Mreža -->
            <Grid Grid.Row="3" x:Name="GridHost" SizeChanged="GridHost_SizeChanged"
                  Visibility="{Binding ShowGrid, Converter={StaticResource BoolVis}}">
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding GridRows}"
                         ItemContainerStyle="{StaticResource PlainRowItem}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GridCellButton}" Click="GridCell_Click" ToolTip="{Binding Name}">
                                            <Grid Margin="14,10,6,12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <DockPanel>
                                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource StarToggle}"
                                                                  IsChecked="{Binding IsFavorite}" Click="FavoriteToggle_Click"/>
                                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource IconToggle}" Content="&#xE8A9;"
                                                                  IsChecked="{Binding IsComparing}" Click="CompareToggle_Click"/>
                                                    <Border/>
                                                </DockPanel>
                                                <TextBlock Grid.Row="1" Text="Aa" FontFamily="{Binding Family}" FontSize="52"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-12,8,0"/>
                                                <StackPanel Grid.Row="2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StyleCountText}" FontSize="11"
                                                               Foreground="{DynamicResource SubTextBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Tablica s metapodacima -->
            <DataGrid Grid.Row="3" Margin="0,0,10,10" ItemsSource="{Binding FontsView}" SelectedItem="{Binding SelectedFont}"
                      Visibility="{Binding ShowTable, Converter={StaticResource BoolVis}}"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource StarToggle}" IsChecked="{Binding IsFavorite, UpdateSourceTrigger=PropertyChanged}"
                                              Click="FavoriteToggle_Click" Margin="-8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Naziv" Width="2*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="16"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Stilovi" Binding="{Binding StyleCount}" Width="70"/>
                    <DataGridTextColumn Header="Verzija" Binding="{Binding Version}" Width="*"/>
                    <DataGridTextColumn Header="Dizajner" Binding="{Binding Designer}" Width="*"/>
                    <DataGridTextColumn Header="Proizvođač" Binding="{Binding Manufacturer}" Width="*"/>
                    <DataGridTextColumn Header="Mono" Binding="{Binding MonoText}" Width="60"/>
                    <DataGridTextColumn Header="čćđšž" Binding="{Binding CroatianText}" Width="60"/>
                    <DataGridTextColumn Header="Izvor" Binding="{Binding SourceShort}" Width="90"/>
                    <DataGridTextColumn Header="Tagovi" Binding="{Binding TagsText}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Prazno stanje biblioteke -->
            <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding VisibleCount}" Value="0"/>
                                    <Condition Binding="{Binding IsLibraryMode}" Value="True"/>
                                    <Condition Binding="{Binding IsCompareMode}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xE8D2;" FontFamily="{StaticResource IconFont}" FontSize="40"
                           Foreground="{DynamicResource LineBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Nema fontova za prikaz" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                <TextBlock Text="Promijeni pretragu ili odaberi drugu kategoriju." Foreground="{DynamicResource SubTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Usporedba -->
            <Grid Grid.Row="3" Visibility="{Binding ShowCompare, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,10,12" Visibility="{Binding HasCompare, Converter={StaticResource BoolVis}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0" Content="Očisti usporedbu"
                            Click="ClearCompare_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Content="⇄ Zamijeni A i B"
                            Click="SwapCompare_Click" Visibility="{Binding HasTwoCompare, Converter={StaticResource BoolVis}}"/>
                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Stupci" IsChecked="{Binding IsColumnsCompare}"/>
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Preklapanje A/B" IsChecked="{Binding IsOverlayCompare}"/>
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Par naslov + tekst" IsChecked="{Binding IsPairingCompare}"/>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <!-- Stupci -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasCompare}" Value="True"/>
                                        <Condition Binding="{Binding IsColumnsCompare}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding CompareFonts}" Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="360" Margin="0,0,12,0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                                        Padding="18,12,10,16">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                                                    ToolTip="Ukloni iz usporedbe" Click="RemoveCompare_Click"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock TextWrapping="Wrap" FontFamily="{Binding Family}"
                                                           Text="{Binding DataContext.EffectivePreviewText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="{Binding DataContext.PreviewSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" FontSize="22" FontFamily="{Binding Family}"
                                                           Text="{Binding DataContext.Upper, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="22" FontFamily="{Binding Family}"
                                                           Text="{Binding DataContext.Lower, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="18" FontFamily="{Binding Family}"
                                                           Text="{Binding DataContext.Digits, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                                                           FontFamily="{Binding Family}" Foreground="{DynamicResource BodyTextBrush}"
                                                           Text="{Binding DataContext.Paragraph, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="14" FontWeight="Bold"
                                                           FontFamily="{Binding Family}" Text="Podebljano — Bold 0123"/>
                                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="14" FontStyle="Italic"
                                                           FontFamily="{Binding Family}" Text="Kurziv — Italic 0123"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Preklapanje A/B -->
                <Border Grid.Row="1" Margin="0,0,10,14" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="24,18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasTwoCompare}" Value="True"/>
                                        <Condition Binding="{Binding IsOverlayCompare}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource OverlayABrush}" VerticalAlignment="Center"/>
                            <TextBlock Margin="8,0,20,0" VerticalAlignment="Center">
                                <Run Text="A: "/><Run Text="{Binding CompareA.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource OverlayBBrush}" VerticalAlignment="Center"/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                <Run Text="B: "/><Run Text="{Binding CompareB.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding EffectivePreviewText}" FontFamily="{Binding CompareA.Family}"
                                               FontSize="{Binding OverlaySize}" TextWrapping="Wrap" Opacity="0.75"
                                               Foreground="{DynamicResource OverlayABrush}"/>
                                    <TextBlock Text="{Binding EffectivePreviewText}" FontFamily="{Binding CompareB.Family}"
                                               FontSize="{Binding OverlaySize}" TextWrapping="Wrap" Opacity="0.75"
                                               Foreground="{DynamicResource OverlayBBrush}"/>
                                </Grid>
                                <Grid Margin="0,24,0,0">
                                    <TextBlock Text="Hamburgefonstiv ĐČŽ 0123" FontFamily="{Binding CompareA.Family}" FontSize="72"
                                               TextWrapping="Wrap" Opacity="0.75" Foreground="{DynamicResource OverlayABrush}"/>
                                    <TextBlock Text="Hamburgefonstiv ĐČŽ 0123" FontFamily="{Binding CompareB.Family}" FontSize="72"
                                               TextWrapping="Wrap" Opacity="0.75" Foreground="{DynamicResource OverlayBBrush}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Par naslov + tekst -->
                <Border Grid.Row="1" Margin="0,0,10,14" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="40,30">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasTwoCompare}" Value="True"/>
                                        <Condition Binding="{Binding IsPairingCompare}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,0,0,18">
                                <Run Text="Naslov: "/><Run Text="{Binding CompareA.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="   ·   Tekst: "/><Run Text="{Binding CompareB.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Text="TIPOGRAFIJA · BROJ 12" FontFamily="{Binding CompareB.Family}" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding EffectivePreviewText}" FontFamily="{Binding CompareA.Family}" FontSize="46"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="54"/>
                            <TextBlock FontFamily="{Binding CompareB.Family}" FontSize="19" TextWrapping="Wrap" Margin="0,14,0,0"
                                       Foreground="{DynamicResource BodyTextBrush}" LineHeight="28"
                                       Text="Kako odabrati dva fonta koja se slažu: kontrast u obliku, sklad u proporcijama i jasna hijerarhija."/>
                            <TextBlock Text="{Binding Paragraph}" FontFamily="{Binding CompareB.Family}" FontSize="16"
                                       TextWrapping="Wrap" Margin="0,22,0,0" LineHeight="27"/>
                            <TextBlock Text="Dobar par fontova ne viče — razgovara." FontFamily="{Binding CompareA.Family}" FontSize="28"
                                       FontStyle="Italic" TextWrapping="Wrap" Margin="0,22,0,0"/>
                            <TextBlock FontFamily="{Binding CompareB.Family}" FontSize="16" TextWrapping="Wrap" Margin="0,22,0,0" LineHeight="27"
                                       Text="Naslovni font nosi karakter, a font za tekst mora biti udoban za dugo čitanje. Kad se vrate jedan drugome, stranica diše. Isprobaj i zamjenu uloga gumbom iznad."/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Prazna usporedba -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasCompare, Converter={StaticResource BoolVisInv}}">
                    <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="40"
                               Foreground="{DynamicResource LineBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Usporedba je prazna" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="Na karticama fontova klikni ikonu usporedbe&#x0a;i fontovi će se ovdje pojaviti jedan do drugoga."/>
                </StackPanel>
                <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource SubTextBrush}" Text="Za ovaj prikaz dodaj barem dva fonta u usporedbu.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasCompare}" Value="True"/>
                                        <Condition Binding="{Binding HasTwoCompare}" Value="False"/>
                                        <Condition Binding="{Binding IsColumnsCompare}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Google Fonts -->
            <Grid Grid.Row="2" Grid.RowSpan="2" Margin="0,12,0,0" Visibility="{Binding IsGoogleMode, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,10,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Osvježi katalog"
                            Foreground="{DynamicResource SubTextBrush}" Click="RefreshGoogle_Click"/>
                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Sve" Tag="" IsChecked="True" Checked="GoogleCategory_Checked"/>
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Sans serif" Tag="Sans Serif" Checked="GoogleCategory_Checked"/>
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Serif" Tag="Serif" Checked="GoogleCategory_Checked"/>
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Display" Tag="Display" Checked="GoogleCategory_Checked"/>
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Rukopisni" Tag="Handwriting" Checked="GoogleCategory_Checked"/>
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Mono" Tag="Monospace" Checked="GoogleCategory_Checked"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding GoogleStatus}" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,10"
                           TextWrapping="Wrap"/>
                <ListBox Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding GoogleView}"
                         ItemContainerStyle="{StaticResource FontCardItem}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionButton}" Margin="0,0,6,0" Content="Prikaži"
                                            Visibility="{Binding IsDownloaded, Converter={StaticResource BoolVis}}"
                                            Click="ShowGoogleFont_Click"/>
                                    <Button Style="{StaticResource AccentButton}" Margin="0" Content="{Binding ButtonText}"
                                            Click="DownloadGoogle_Click" MinWidth="96"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Family}" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Info}" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- ===================== DETALJI ===================== -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30"
                            Visibility="{Binding SelectedFont, Converter={StaticResource NullVisInv}}">
                    <TextBlock Text="Aa" FontFamily="Georgia" FontSize="64" Foreground="{DynamicResource LineBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Odaberi font za detalje" FontSize="15" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="stilovi, tagovi, glifovi, tester i aktivacija" Foreground="{DynamicResource SubTextBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Visibility="{Binding SelectedFont, Converter={StaticResource NullVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="24,20,24,0">
                        <TextBlock Text="Aa" FontFamily="{Binding SelectedFont.Family}" FontSize="84" LineHeight="96"
                                   LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SelectedFont.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                        <TextBlock Foreground="{DynamicResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0">
                            <Run Text="{Binding SelectedFont.StyleCountText, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding SelectedFont.SourceLabel, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource BgBrush}" CornerRadius="8" Padding="3"
                            HorizontalAlignment="Left" Margin="24,16,24,4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Detalji" IsChecked="{Binding ShowDetails}"/>
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Glifovi" IsChecked="{Binding ShowGlyphs}"/>
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Tester" IsChecked="{Binding ShowTester}"
                                         ToolTip="OpenType značajke i varijabilne osi"/>
                        </StackPanel>
                    </Border>

                    <!-- Detalji -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ShowDetails, Converter={StaticResource BoolVis}}">
                        <StackPanel Margin="24,8,20,24">
                            <WrapPanel Margin="0,8,0,0">
                                <ToggleButton Style="{StaticResource PillToggle}" IsChecked="{Binding SelectedFont.IsFavorite}"
                                              Click="DetailFavorite_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Favorit"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource PillToggle}" IsChecked="{Binding SelectedFont.IsComparing}"
                                              Click="DetailCompare_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Usporedi"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Button Style="{StaticResource AccentButton}" Content="{Binding SelectedFont.ActivateText}"
                                        Visibility="{Binding SelectedFont.IsFromFolder, Converter={StaticResource BoolVis}}"
                                        ToolTip="Učini font dostupnim u svim aplikacijama, bez instalacije"
                                        Click="Activate_Click"/>
                                <Button Style="{StaticResource ActionButton}" Content="Instaliraj trajno"
                                        Visibility="{Binding SelectedFont.IsFromFolder, Converter={StaticResource BoolVis}}"
                                        ToolTip="Kopira font u tvoje korisničke fontove (bez administratorskih prava)"
                                        Click="Install_Click"/>
                                <Button Style="{StaticResource ActionButton}" Content="Izvezi datoteke" Click="ExportFont_Click"
                                        ToolTip="Kopiraj datoteke fonta u odabranu mapu"/>
                                <Button Style="{StaticResource ActionButton}" Content="Prikaži datoteku" Click="ShowInExplorer_Click"/>
                                <Button Style="{StaticResource ActionButton}" Content="Kopiraj naziv" Click="CopyName_Click"/>
                            </WrapPanel>

                            <TextBlock Text="TAGOVI" Style="{StaticResource DetailTitle}" Margin="0,16,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedFont.Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="10,3,3,3"
                                                Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9"
                                                        Padding="5" Margin="4,0,0,0" Tag="{Binding}"
                                                        Foreground="{DynamicResource AccentBrush}" ToolTip="Makni tag"
                                                        Click="RemoveTagFromFont_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="AddTagBox" Tag="Dodaj tag i pritisni Enter" KeyDown="AddTagBox_KeyDown"
                                     Margin="0,2,0,0"/>
                            <ItemsControl ItemsSource="{Binding SuggestedTags}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" Padding="8,3" Margin="0,0,4,4"
                                                Tag="{Binding}" Click="AddSuggestedTag_Click" Foreground="{DynamicResource SubTextBrush}">
                                            <TextBlock>
                                                <Run Text="+ "/><Run Text="{Binding Mode=OneWay}"/>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="INFORMACIJE" Style="{StaticResource DetailTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Verzija" Foreground="{DynamicResource SubTextBrush}" Margin="0,2"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedFont.Version}" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Text="Dizajner" Foreground="{DynamicResource SubTextBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedFont.Designer}" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Text="Proizvođač" Foreground="{DynamicResource SubTextBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedFont.Manufacturer}" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Text="Datoteka" Foreground="{DynamicResource SubTextBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedFont.MainFile}" TextWrapping="Wrap"
                                           Margin="0,2" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                            </Grid>

                            <TextBlock Text="STILOVI" Style="{StaticResource DetailTitle}"/>
                            <ItemsControl ItemsSource="{Binding SelectedFont.Styles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="0"
                                                          IsChecked="{Binding IsActivated, Mode=OneWay}" Click="ToggleStyle_Click"
                                                          Visibility="{Binding CanToggle, Converter={StaticResource BoolVis}}"
                                                          ToolTip="Aktiviraj samo ovaj stil" Content="aktivan"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SubTextBrush}" FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock FontFamily="{Binding Family}" FontWeight="{Binding Weight}"
                                                       FontStyle="{Binding Style}" FontStretch="{Binding Stretch}"
                                                       FontSize="24" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Text="{Binding DataContext.EffectivePreviewText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="ABECEDA" Style="{StaticResource DetailTitle}" Margin="0,8,0,8"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Upper}" FontFamily="{Binding SelectedFont.Family}" FontSize="22" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Lower}" FontFamily="{Binding SelectedFont.Family}" FontSize="22" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Digits}" FontFamily="{Binding SelectedFont.Family}" FontSize="18" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Paragraph}" FontFamily="{Binding SelectedFont.Family}" FontSize="14"
                                           LineHeight="22" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{DynamicResource BodyTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Glifovi -->
                    <Grid Grid.Row="2" Visibility="{Binding ShowGlyphs, Converter={StaticResource BoolVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Margin="24,10,24,0" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16"
                                Visibility="{Binding SelectedGlyph, Converter={StaticResource NullVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedGlyph.Text}" FontFamily="{Binding SelectedFont.Family}"
                                           FontSize="84" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding SelectedGlyph.Code}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedGlyph.Decimal}" Foreground="{DynamicResource SubTextBrush}"
                                               Margin="0,2,0,10"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource ActionButton}" Content="Kopiraj znak" Click="CopyGlyph_Click"/>
                                        <Button Style="{StaticResource ActionButton}" Content="Kopiraj kod" Click="CopyGlyphCode_Click"/>
                                        <Button Style="{StaticResource ActionButton}" Content="SVG" Click="SaveGlyphSvg_Click"
                                                ToolTip="Spremi znak kao vektorsku SVG datoteku"/>
                                        <Button Style="{StaticResource ActionButton}" Content="PNG" Click="SaveGlyphPng_Click"
                                                ToolTip="Spremi znak kao PNG (512 px, prozirna pozadina)"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DockPanel Grid.Row="1" Margin="24,10,24,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,4"
                                    Foreground="{DynamicResource SubTextBrush}" Content="Kopiraj sve znakove" Click="CopyAllGlyphs_Click"/>
                            <TextBlock Text="{Binding GlyphInfo}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0,14,16">
                            <ItemsControl ItemsSource="{Binding Glyphs}" FontFamily="{Binding SelectedFont.Family}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GlyphCell}" Content="{Binding Text}" ToolTip="{Binding Code}"
                                                Click="Glyph_Click"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Tester -->
                    <Grid Grid.Row="2" Visibility="{Binding ShowTester, Converter={StaticResource BoolVis}}">
                        <wv2:WebView2 x:Name="TesterView" Margin="0,6,0,0"/>
                        <TextBlock x:Name="TesterMessage" Margin="24" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
