<Window x:Class="FontShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FontShelf.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FontShelf" Height="900" Width="1500" MinWidth="1100" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        SourceInitialized="Window_SourceInitialized" StateChanged="Window_StateChanged">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullVis"/>
        <conv:NullToVisibilityConverter x:Key="NullVisInv" Invert="True"/>
        <conv:TagBrushConverter x:Key="TagBrush"/>

        <Style x:Key="GlyphCell" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <Style x:Key="PlainRowItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="214" Height="172" Margin="0,0,14,14" CornerRadius="12"
                                Background="{DynamicResource CardBrush}" BorderThickness="1.5" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigacija -->
        <DataTemplate x:Key="LibraryEntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{DynamicResource SubTextBrush}"
                           FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TagEntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="{Binding Value, Converter={StaticResource TagBrush}}"
                         HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="2">
                    <TextBlock x:Name="Cnt" Text="{Binding Count}" Foreground="{DynamicResource SubTextBrush}"
                               FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <StackPanel x:Name="Acts" Orientation="Horizontal" Visibility="Collapsed" Margin="0,-5">
                        <Button Style="{StaticResource IconButton}" Content="&#xEDE1;" Padding="5" FontSize="12"
                                ToolTip="Izvezi sve fontove s ovim tagom u mapu" Click="ExportTag_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Padding="5" FontSize="12"
                                ToolTip="Obriši tag" Click="DeleteTag_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Cnt" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Acts" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="FolderEntryTemplate">
            <Grid ToolTip="{Binding Value}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="2">
                    <TextBlock x:Name="Cnt" Text="{Binding Count}" Foreground="{DynamicResource SubTextBrush}"
                               FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <StackPanel x:Name="Acts" Orientation="Horizontal" Visibility="Collapsed" Margin="0,-5">
                        <Button Style="{StaticResource IconButton}" Content="&#xE945;" Padding="5" FontSize="12"
                                ToolTip="Aktiviraj / deaktiviraj sve fontove iz mape" Click="ToggleFolderActivation_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" Padding="5" FontSize="12"
                                ToolTip="Ukloni mapu iz biblioteke" Click="RemoveFolder_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Cnt" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Acts" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Tag s obojenom točkicom -->
        <DataTemplate x:Key="TagChipTemplate">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{Binding Converter={StaticResource TagBrush}}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" Margin="5,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- Značke fonta (diskretne) -->
        <DataTemplate x:Key="BadgesTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Badge}" Visibility="{Binding HasActivationLabel, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding ActivationLabel}" FontSize="11" Foreground="{DynamicResource GoodBrush}"/>
                </Border>
                <Border Style="{StaticResource Badge}" Visibility="{Binding IsVariable, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="varijabilni" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
                <Border Style="{StaticResource Badge}" Visibility="{Binding IsMonoBadge, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="mono" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                </Border>
                <Border Style="{StaticResource Badge}" Visibility="{Binding IsDuplicate, Converter={StaticResource BoolVis}}"
                        ToolTip="Font s istim imenom postoji više puta">
                    <TextBlock Text="duplikat" FontSize="11" Foreground="{DynamicResource WarnBrush}"/>
                </Border>
                <Border Style="{StaticResource Badge}" Visibility="{Binding MissingCroatian, Converter={StaticResource BoolVis}}"
                        ToolTip="Font nema sva slova č ć đ š ž">
                    <TextBlock Text="bez čćđšž" FontSize="11" Foreground="{DynamicResource WarnBrush}"/>
                </Border>
                <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChipTemplate}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Redak fonta -->
        <DataTemplate x:Key="FontRowTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Height="28">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,-2,0,0">
                        <StackPanel x:Name="Acts" Orientation="Horizontal" Opacity="0">
                            <ToggleButton Style="{StaticResource ActivateToggle}" Content="&#xE945;"
                                          ToolTip="Aktiviraj / deaktiviraj (bez instalacije)"
                                          IsChecked="{Binding IsActivated, Mode=OneWay}" Click="RowActivate_Click"
                                          Visibility="{Binding IsFromFolder, Converter={StaticResource BoolVis}}"/>
                            <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE8A9;" ToolTip="Dodaj u usporedbu"
                                          IsChecked="{Binding IsComparing}" Click="CompareToggle_Click"/>
                        </StackPanel>
                        <ToggleButton x:Name="Star" Style="{StaticResource StarToggle}" ToolTip="Favorit" Opacity="0"
                                      IsChecked="{Binding IsFavorite}" Click="FavoriteToggle_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="·" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="7,0" Opacity="0.6"/>
                        <TextBlock Text="{Binding StyleCountText}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"
                                   VerticalAlignment="Center" Opacity="0.85"/>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BadgesTemplate}" Margin="4,0,0,0"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Grid.Row="1" Margin="0,2,10,0"
                           Text="{Binding DataContext.CardText, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="{Binding DataContext.CardFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           TextWrapping="{Binding DataContext.CardWrap, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="{Binding Family}" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Acts" Property="Opacity" Value="1"/>
                    <Setter TargetName="Star" Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Acts" Property="Opacity" Value="1"/>
                    <Setter TargetName="Star" Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="Star" Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsComparing}" Value="True">
                    <Setter TargetName="Acts" Property="Opacity" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Izbornik "više" u inspektoru -->
        <ContextMenu x:Key="MoreMenu">
            <MenuItem Header="Instaliraj trajno" Tag="&#xE896;" Click="Install_Click"
                      Visibility="{Binding SelectedFont.IsFromFolder, Converter={StaticResource BoolVis}}"/>
            <MenuItem Header="Izvezi datoteke…" Tag="&#xEDE1;" Click="ExportFont_Click"/>
            <MenuItem Header="Prikaži datoteku" Tag="&#xE838;" Click="ShowInExplorer_Click"/>
            <MenuItem Header="Kopiraj naziv" Tag="&#xE8C8;" Click="CopyName_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== NASLOVNA TRAKA ===================== -->
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
            <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                <TextBlock Text="Aa" FontFamily="Georgia" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="FontShelf" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                       Margin="10,0,0,1" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="380" Height="34" CornerRadius="8" Background="{DynamicResource InputBrush}" HorizontalAlignment="Left"
                    Margin="10,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="12,0,4,0"
                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource BareTextBox}"
                             Tag="Pretraži fontove, tagove i dizajnere"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Border Grid.Column="2" CornerRadius="4" Background="{DynamicResource ControlBrush}" Padding="6,1" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Ctrl F" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                    </Border>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Smanji"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Povećaj"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Zatvori"/>
            </StackPanel>
        </Grid>

        <!-- ===================== BOČNA TRAKA ===================== -->
        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,12">
                <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch" Padding="12,8" Click="Settings_Click">
                    <Grid Width="196">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Postavke" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,0">
                <StackPanel>
                    <ListBox x:Name="LibraryList" Style="{StaticResource PlainList}" Margin="0,4,0,0"
                             ItemsSource="{Binding LibraryEntries}" ItemTemplate="{StaticResource LibraryEntryTemplate}"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             SelectionChanged="Sidebar_SelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewMouseWheel="Sidebar_PreviewMouseWheel"/>

                    <Grid>
                        <TextBlock Text="Tagovi" Style="{StaticResource SectionTitle}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="11" Padding="6"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,0"
                                ToolTip="Novi tag" Click="NewTag_Click"/>
                    </Grid>
                    <ListBox x:Name="TagList" Style="{StaticResource PlainList}"
                             ItemsSource="{Binding TagEntries}" ItemTemplate="{StaticResource TagEntryTemplate}"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             SelectionChanged="Sidebar_SelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewMouseWheel="Sidebar_PreviewMouseWheel"/>
                    <TextBox x:Name="NewTagBox" Tag="Ime taga, pa Enter" Margin="4,4,4,0" Padding="10,6"
                             KeyDown="NewTagBox_KeyDown" LostKeyboardFocus="NewTagBox_LostFocus" Visibility="Collapsed"/>
                    <TextBlock Text="Označi fontove tagovima da ih grupiraš u kolekcije." TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource SubTextBrush}" Margin="12,0,8,0"
                               Visibility="{Binding HasTags, Converter={StaticResource BoolVisInv}}"/>

                    <Grid>
                        <TextBlock Text="Mape" Style="{StaticResource SectionTitle}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="11" Padding="6"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,0"
                                ToolTip="Dodaj mapu s fontovima" Click="AddFolder_Click"/>
                    </Grid>
                    <ListBox x:Name="FolderList" Style="{StaticResource PlainList}"
                             ItemsSource="{Binding FolderEntries}" ItemTemplate="{StaticResource FolderEntryTemplate}"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             SelectionChanged="Sidebar_SelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewMouseWheel="Sidebar_PreviewMouseWheel"/>
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Padding="12,10" Margin="0,2,0,0"
                            Visibility="{Binding HasFolders, Converter={StaticResource BoolVisInv}}" Click="AddFolder_Click">
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,12"
                                Width="196">
                            <StackPanel>
                                <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Dodaj mapu s fontovima" HorizontalAlignment="Center" Margin="0,6,0,2" FontWeight="SemiBold"/>
                                <TextBlock Text="ili je povuci u prozor" HorizontalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Border Height="16"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Postavke (skočni prozor) -->
        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Top"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" HorizontalOffset="-4">
            <Border Margin="14" Width="320" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20,18" Effect="{StaticResource PopupShadow}"
                    TextElement.Foreground="{DynamicResource TextBrush}">
                <StackPanel>
                    <TextBlock Text="Postavke" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Izgled" Style="{StaticResource DetailTitle}" Margin="0,16,0,8"/>
                    <Border Background="{DynamicResource ControlBrush}" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Kao Windows" IsChecked="{Binding IsThemeSystem}"/>
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Svijetla" IsChecked="{Binding IsThemeLight}"/>
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Tamna" IsChecked="{Binding IsThemeDark}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Biblioteka" Style="{StaticResource DetailTitle}" Margin="0,20,0,4"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Sakrij sistemske fontove" IsChecked="{Binding HideSystemFonts}"/>
                    <TextBlock Text="Prikazuj samo fontove iz svojih mapa. U favoritima i tagovima ostaju vidljivi."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,40,8"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Privremena aktivacija" IsChecked="{Binding TemporaryActivation}"/>
                    <TextBlock Text="Aktivirani fontovi se sami deaktiviraju kad zatvoriš FontShelf."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,40,0"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ===================== SLOJ SADRŽAJA ===================== -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1,1,0,0" CornerRadius="10,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="410"/>
                </Grid.ColumnDefinitions>

                <!-- ============ GLAVNI DIO ============ -->
                <Grid Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Zaglavlje -->
                    <DockPanel Margin="32,24,24,0">
                        <Border DockPanel.Dock="Right" Background="{DynamicResource ControlBrush}" CornerRadius="8" Padding="3"
                                VerticalAlignment="Center" Visibility="{Binding IsLibraryMode, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentButton}" IsChecked="{Binding IsListMode}" ToolTip="Popis">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Popis" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" IsChecked="{Binding IsGridMode}" ToolTip="Mreža">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mreža" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" Content="Tablica" IsChecked="{Binding IsTableMode}"/>
                                <RadioButton Style="{StaticResource SegmentButton}" IsChecked="{Binding IsCompareMode}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CompareTabText}" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding HeaderTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="28"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" Margin="1,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Traka za pregled (FontBase stil) -->
                    <Grid Grid.Row="1" Margin="32,18,24,14" Visibility="{Binding IsLibraryMode, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="40" CornerRadius="10" Background="{DynamicResource InputBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="14,0,4,0"
                                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource BareTextBox}" Tag="Upiši svoj tekst za pregled…"
                                         FontSize="13.5" Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}"/>
                                <Border Grid.Column="2" Width="1" Margin="8,10" Background="{DynamicResource LineBrush}"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8E9;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                    <Slider Width="140" Minimum="10" Maximum="160" Margin="10,0" VerticalAlignment="Center"
                                            Value="{Binding PreviewSize}" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="8"/>
                                    <TextBlock Text="{Binding PreviewSizeText}" Width="42" Foreground="{DynamicResource SubTextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <Border Background="{DynamicResource ControlBrush}" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Redak" IsChecked="{Binding IsLinePreview}"/>
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Odlomak" IsChecked="{Binding IsParagraphPreview}"/>
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Abeceda" IsChecked="{Binding IsAlphabetPreview}"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource GhostButton}" Click="Sort_Click" Margin="8,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Klikni za promjenu redoslijeda" Foreground="{DynamicResource SubTextBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding SortText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Popis fontova -->
                    <ListBox x:Name="FontList" Grid.Row="2" Margin="12,0,0,0" Style="{StaticResource PlainList}"
                             Visibility="{Binding ShowList, Converter={StaticResource BoolVis}}"
                             ItemsSource="{Binding FontsView}" SelectedItem="{Binding SelectedFont}"
                             ItemTemplate="{StaticResource FontRowTemplate}"
                             ItemContainerStyle="{StaticResource FontRowItem}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"/>

                    <!-- Mreža -->
                    <Grid Grid.Row="2" x:Name="GridHost" Margin="32,0,0,0" SizeChanged="GridHost_SizeChanged"
                          Visibility="{Binding ShowGrid, Converter={StaticResource BoolVis}}">
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding GridRows}"
                                 ItemContainerStyle="{StaticResource PlainRowItem}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource TileButton}" Click="GridCell_Click" ToolTip="{Binding Name}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="Aa" FontFamily="{Binding Family}" FontSize="58"
                                                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,8,0,0"/>
                                                        <StackPanel x:Name="TileActs" Orientation="Horizontal" HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top" Margin="0,6,6,0">
                                                            <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE8A9;"
                                                                          IsChecked="{Binding IsComparing}" Click="CompareToggle_Click"/>
                                                            <ToggleButton Style="{StaticResource StarToggle}"
                                                                          IsChecked="{Binding IsFavorite}" Click="FavoriteToggle_Click"/>
                                                        </StackPanel>
                                                        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                                                                Padding="18,10,14,12">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding StyleCountText}" FontSize="11.5"
                                                                               Foreground="{DynamicResource SubTextBrush}"/>
                                                                    <TextBlock Text="  ·  aktiviran" FontSize="11.5" Foreground="{DynamicResource GoodBrush}"
                                                                               Visibility="{Binding IsActivated, Converter={StaticResource BoolVis}}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Tablica s metapodacima -->
                    <DataGrid Grid.Row="2" Margin="24,0,16,10" ItemsSource="{Binding FontsView}" SelectedItem="{Binding SelectedFont}"
                              Visibility="{Binding ShowTable, Converter={StaticResource BoolVis}}"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource StarToggle}" IsChecked="{Binding IsFavorite, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="FavoriteToggle_Click" Margin="-8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Naziv" Width="2*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="17"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Stilovi" Binding="{Binding StyleCount}" Width="70"/>
                            <DataGridTextColumn Header="Verzija" Binding="{Binding Version}" Width="*"/>
                            <DataGridTextColumn Header="Dizajner" Binding="{Binding Designer}" Width="*"/>
                            <DataGridTextColumn Header="Proizvođač" Binding="{Binding Manufacturer}" Width="*"/>
                            <DataGridTextColumn Header="Mono" Binding="{Binding MonoText}" Width="60"/>
                            <DataGridTextColumn Header="čćđšž" Binding="{Binding CroatianText}" Width="60"/>
                            <DataGridTextColumn Header="Izvor" Binding="{Binding SourceShort}" Width="90"/>
                            <DataGridTextColumn Header="Tagovi" Binding="{Binding TagsText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Prazno stanje biblioteke -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding VisibleCount}" Value="0"/>
                                            <Condition Binding="{Binding IsLibraryMode}" Value="True"/>
                                            <Condition Binding="{Binding IsCompareMode}" Value="False"/>
                                            <Condition Binding="{Binding IsBusy}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Aa" FontFamily="Georgia" FontSize="56" Foreground="{DynamicResource LineBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nema fontova za prikaz" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                                   FontWeight="SemiBold" Margin="0,10,0,4" HorizontalAlignment="Center"/>
                        <TextBlock Text="Promijeni pretragu ili odaberi drugu kolekciju." Foreground="{DynamicResource SubTextBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Usporedba -->
                    <Grid Grid.Row="1" Grid.RowSpan="2" Margin="32,18,24,0" Visibility="{Binding ShowCompare, Converter={StaticResource BoolVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,14" Visibility="{Binding HasCompare, Converter={StaticResource BoolVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0" Content="Očisti"
                                    Click="ClearCompare_Click"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Content="⇄  Zamijeni A i B"
                                    Click="SwapCompare_Click" Visibility="{Binding HasTwoCompare, Converter={StaticResource BoolVis}}"/>
                            <Border Background="{DynamicResource ControlBrush}" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Stupci" IsChecked="{Binding IsColumnsCompare}"/>
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Preklapanje A/B" IsChecked="{Binding IsOverlayCompare}"/>
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Par naslov + tekst" IsChecked="{Binding IsPairingCompare}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- Stupci -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasCompare}" Value="True"/>
                                                <Condition Binding="{Binding IsColumnsCompare}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding CompareFonts}" Margin="0,0,0,16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="360" Margin="0,0,14,0" Background="{DynamicResource CardBrush}" CornerRadius="12"
                                                Padding="22,14,12,18">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                                                            ToolTip="Ukloni iz usporedbe" Click="RemoveCompare_Click"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock TextWrapping="Wrap" FontFamily="{Binding Family}"
                                                                   Text="{Binding DataContext.EffectivePreviewText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontSize="{Binding DataContext.PreviewSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" FontSize="22" FontFamily="{Binding Family}"
                                                                   Text="{Binding DataContext.Upper, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="22" FontFamily="{Binding Family}"
                                                                   Text="{Binding DataContext.Lower, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="18" FontFamily="{Binding Family}"
                                                                   Text="{Binding DataContext.Digits, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                                                                   FontFamily="{Binding Family}" Foreground="{DynamicResource BodyTextBrush}"
                                                                   Text="{Binding DataContext.Paragraph, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="14" FontWeight="Bold"
                                                                   FontFamily="{Binding Family}" Text="Podebljano — Bold 0123"/>
                                                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="14" FontStyle="Italic"
                                                                   FontFamily="{Binding Family}" Text="Kurziv — Italic 0123"/>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Preklapanje A/B -->
                        <Border Grid.Row="1" Margin="0,0,0,16" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="28,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasTwoCompare}" Value="True"/>
                                                <Condition Binding="{Binding IsOverlayCompare}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource OverlayABrush}" VerticalAlignment="Center"/>
                                    <TextBlock Margin="8,0,22,0" VerticalAlignment="Center">
                                        <Run Text="A  " Foreground="{DynamicResource SubTextBrush}"/><Run Text="{Binding CompareA.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource OverlayBBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Run Text="B  " Foreground="{DynamicResource SubTextBrush}"/><Run Text="{Binding CompareB.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding EffectivePreviewText}" FontFamily="{Binding CompareA.Family}"
                                                       FontSize="{Binding OverlaySize}" TextWrapping="Wrap" Opacity="0.75"
                                                       Foreground="{DynamicResource OverlayABrush}"/>
                                            <TextBlock Text="{Binding EffectivePreviewText}" FontFamily="{Binding CompareB.Family}"
                                                       FontSize="{Binding OverlaySize}" TextWrapping="Wrap" Opacity="0.75"
                                                       Foreground="{DynamicResource OverlayBBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,24,0,0">
                                            <TextBlock Text="Hamburgefonstiv ĐČŽ 0123" FontFamily="{Binding CompareA.Family}" FontSize="72"
                                                       TextWrapping="Wrap" Opacity="0.75" Foreground="{DynamicResource OverlayABrush}"/>
                                            <TextBlock Text="Hamburgefonstiv ĐČŽ 0123" FontFamily="{Binding CompareB.Family}" FontSize="72"
                                                       TextWrapping="Wrap" Opacity="0.75" Foreground="{DynamicResource OverlayBBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Par naslov + tekst -->
                        <Border Grid.Row="1" Margin="0,0,0,16" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="44,32">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasTwoCompare}" Value="True"/>
                                                <Condition Binding="{Binding IsPairingCompare}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                                    <TextBlock Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,0,0,20">
                                        <Run Text="Naslov: "/><Run Text="{Binding CompareA.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="   ·   Tekst: "/><Run Text="{Binding CompareB.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Text="TIPOGRAFIJA · BROJ 12" FontFamily="{Binding CompareB.Family}" FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding EffectivePreviewText}" FontFamily="{Binding CompareA.Family}" FontSize="46"
                                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="54"/>
                                    <TextBlock FontFamily="{Binding CompareB.Family}" FontSize="19" TextWrapping="Wrap" Margin="0,14,0,0"
                                               Foreground="{DynamicResource BodyTextBrush}" LineHeight="28"
                                               Text="Kako odabrati dva fonta koja se slažu: kontrast u obliku, sklad u proporcijama i jasna hijerarhija."/>
                                    <TextBlock Text="{Binding Paragraph}" FontFamily="{Binding CompareB.Family}" FontSize="16"
                                               TextWrapping="Wrap" Margin="0,22,0,0" LineHeight="27"/>
                                    <TextBlock Text="Dobar par fontova ne viče — razgovara." FontFamily="{Binding CompareA.Family}" FontSize="28"
                                               FontStyle="Italic" TextWrapping="Wrap" Margin="0,22,0,0"/>
                                    <TextBlock FontFamily="{Binding CompareB.Family}" FontSize="16" TextWrapping="Wrap" Margin="0,22,0,0" LineHeight="27"
                                               Text="Naslovni font nosi karakter, a font za tekst mora biti udoban za dugo čitanje. Kad se slažu, stranica diše. Isprobaj i zamjenu uloga gumbom iznad."/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Prazna usporedba -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasCompare, Converter={StaticResource BoolVisInv}}">
                            <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="40"
                                       Foreground="{DynamicResource LineBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Usporedba je prazna" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                                       FontWeight="SemiBold" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                            <TextBlock Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                                       Text="Prijeđi mišem preko fonta i klikni ikonu usporedbe&#x0a;— fontovi će se ovdje pojaviti jedan do drugoga."/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource SubTextBrush}" Text="Za ovaj prikaz dodaj barem dva fonta u usporedbu.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasCompare}" Value="True"/>
                                                <Condition Binding="{Binding HasTwoCompare}" Value="False"/>
                                                <Condition Binding="{Binding IsColumnsCompare}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Google Fonts -->
                    <Grid Grid.Row="1" Grid.RowSpan="2" Margin="32,18,12,0" Visibility="{Binding IsGoogleMode, Converter={StaticResource BoolVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,12,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Foreground="{DynamicResource SubTextBrush}"
                                    Click="RefreshGoogle_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="Osvježi katalog"/>
                                </StackPanel>
                            </Button>
                            <Border Background="{DynamicResource ControlBrush}" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Sve" Tag="" IsChecked="True" Checked="GoogleCategory_Checked"/>
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Sans serif" Tag="Sans Serif" Checked="GoogleCategory_Checked"/>
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Serif" Tag="Serif" Checked="GoogleCategory_Checked"/>
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Display" Tag="Display" Checked="GoogleCategory_Checked"/>
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Rukopisni" Tag="Handwriting" Checked="GoogleCategory_Checked"/>
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Mono" Tag="Monospace" Checked="GoogleCategory_Checked"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding GoogleStatus}" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>
                        <ListBox Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding GoogleView}"
                                 ItemContainerStyle="{StaticResource FontCardItem}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ActionButton}" Margin="0,0,6,0" Content="Prikaži"
                                                    Visibility="{Binding IsDownloaded, Converter={StaticResource BoolVis}}"
                                                    Click="ShowGoogleFont_Click"/>
                                            <Button Style="{StaticResource AccentButton}" Margin="0" Content="{Binding ButtonText}"
                                                    Click="DownloadGoogle_Click" MinWidth="100"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Family}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Info}" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <!-- ============ INSPEKTOR ============ -->
                <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30"
                                    Visibility="{Binding SelectedFont, Converter={StaticResource NullVisInv}}">
                            <TextBlock Text="Aa" FontFamily="Georgia" FontSize="72" Foreground="{DynamicResource LineBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Odaberi font" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ovdje se prikazuju stilovi, tagovi, glifovi&#x0a;i tester OpenType značajki."
                                       Foreground="{DynamicResource SubTextBrush}" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Grid Visibility="{Binding SelectedFont, Converter={StaticResource NullVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="26,24,26,0">
                                <Border Height="148" CornerRadius="12" Background="{DynamicResource CardBrush}" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="Aa" FontFamily="{Binding SelectedFont.Family}" FontSize="96"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedFont.StyleCountText}" FontSize="11" Margin="12,10"
                                                   Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding SelectedFont.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,0"/>
                                <TextBlock Text="{Binding SelectedFont.SourceLabel}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding SelectedFont.SourceLabel}"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Style="{StaticResource AccentButton}"
                                            Visibility="{Binding SelectedFont.IsFromFolder, Converter={StaticResource BoolVis}}"
                                            ToolTip="Učini font dostupnim u svim aplikacijama, bez instalacije" Click="Activate_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding SelectedFont.ActivateText}"/>
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton Style="{StaticResource PillToggle}" IsChecked="{Binding SelectedFont.IsFavorite}"
                                                  Click="DetailFavorite_Click" ToolTip="Favorit">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="Favorit"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource PillToggle}" IsChecked="{Binding SelectedFont.IsComparing}"
                                                  Click="DetailCompare_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="Usporedi"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button Style="{StaticResource ActionButton}" Content="&#xE712;" FontFamily="{StaticResource IconFont}"
                                            Padding="10,8" ToolTip="Više" Click="More_Click" ContextMenu="{StaticResource MoreMenu}"/>
                                </WrapPanel>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="26,8,26,0">
                                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource LineBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource TabButton}" Content="Pregled" IsChecked="{Binding ShowDetails}"/>
                                    <RadioButton Style="{StaticResource TabButton}" Content="Glifovi" IsChecked="{Binding ShowGlyphs}"/>
                                    <RadioButton Style="{StaticResource TabButton}" Content="Tester" IsChecked="{Binding ShowTester}"
                                                 ToolTip="OpenType značajke i varijabilne osi"/>
                                </StackPanel>
                            </Grid>

                            <!-- Pregled -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding ShowDetails, Converter={StaticResource BoolVis}}">
                                <StackPanel Margin="26,4,22,28">
                                    <TextBlock Text="Tagovi" Style="{StaticResource DetailTitle}" Margin="0,18,0,10"/>
                                    <ItemsControl ItemsSource="{Binding SelectedFont.Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ControlBrush}" CornerRadius="14" Padding="10,3,3,3"
                                                        Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Converter={StaticResource TagBrush}}"
                                                                 VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9"
                                                                Padding="6" Margin="4,0,0,0" Tag="{Binding}" ToolTip="Makni tag"
                                                                Click="RemoveTagFromFont_Click"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBox x:Name="AddTagBox" Tag="+ Dodaj tag i pritisni Enter" KeyDown="AddTagBox_KeyDown"
                                             Margin="0,2,0,0"/>
                                    <ItemsControl ItemsSource="{Binding SuggestedTags}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GhostButton}" Padding="8,3" Margin="0,0,4,4"
                                                        Tag="{Binding}" Click="AddSuggestedTag_Click" Foreground="{DynamicResource SubTextBrush}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding Converter={StaticResource TagBrush}}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Informacije" Style="{StaticResource DetailTitle}"/>
                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Verzija" Foreground="{DynamicResource SubTextBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedFont.Version}" TextWrapping="Wrap" Margin="0,4"/>
                                            <TextBlock Grid.Row="1" Text="Dizajner" Foreground="{DynamicResource SubTextBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedFont.Designer}" TextWrapping="Wrap" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Text="Proizvođač" Foreground="{DynamicResource SubTextBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedFont.Manufacturer}" TextWrapping="Wrap" Margin="0,4"/>
                                            <TextBlock Grid.Row="3" Text="Datoteka" Foreground="{DynamicResource SubTextBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedFont.MainFile}" TextWrapping="Wrap"
                                                       Margin="0,4" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="Stilovi" Style="{StaticResource DetailTitle}"/>
                                    <ItemsControl ItemsSource="{Binding SelectedFont.Styles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,16">
                                                    <DockPanel>
                                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="0" FontSize="11.5"
                                                                  IsChecked="{Binding IsActivated, Mode=OneWay}" Click="ToggleStyle_Click"
                                                                  Visibility="{Binding CanToggle, Converter={StaticResource BoolVis}}"
                                                                  ToolTip="Aktiviraj samo ovaj stil" Content="aktivan"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5"
                                                                   VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                    <TextBlock FontFamily="{Binding Family}" FontWeight="{Binding Weight}"
                                                               FontStyle="{Binding Style}" FontStretch="{Binding Stretch}"
                                                               FontSize="24" TextWrapping="Wrap" Margin="0,3,0,0"
                                                               Text="{Binding DataContext.EffectivePreviewText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Abeceda" Style="{StaticResource DetailTitle}" Margin="0,8,0,10"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Upper}" FontFamily="{Binding SelectedFont.Family}" FontSize="22" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Lower}" FontFamily="{Binding SelectedFont.Family}" FontSize="22" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Digits}" FontFamily="{Binding SelectedFont.Family}" FontSize="18" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Paragraph}" FontFamily="{Binding SelectedFont.Family}" FontSize="14"
                                                   LineHeight="22" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{DynamicResource BodyTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Glifovi -->
                            <Grid Grid.Row="2" Visibility="{Binding ShowGlyphs, Converter={StaticResource BoolVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Margin="26,16,26,0" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16"
                                        Visibility="{Binding SelectedGlyph, Converter={StaticResource NullVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SelectedGlyph.Text}" FontFamily="{Binding SelectedFont.Family}"
                                                   FontSize="84" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding SelectedGlyph.Code}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedGlyph.Decimal}" Foreground="{DynamicResource SubTextBrush}"
                                                       Margin="0,2,0,10"/>
                                            <WrapPanel>
                                                <Button Style="{StaticResource ActionButton}" Content="Kopiraj" Click="CopyGlyph_Click"/>
                                                <Button Style="{StaticResource ActionButton}" Content="Kod" Click="CopyGlyphCode_Click"
                                                        ToolTip="Kopiraj Unicode kod"/>
                                                <Button Style="{StaticResource ActionButton}" Content="SVG" Click="SaveGlyphSvg_Click"
                                                        ToolTip="Spremi znak kao vektorsku SVG datoteku"/>
                                                <Button Style="{StaticResource ActionButton}" Content="PNG" Click="SaveGlyphPng_Click"
                                                        ToolTip="Spremi znak kao PNG (512 px, prozirna pozadina)"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DockPanel Grid.Row="1" Margin="26,12,26,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,4"
                                            Foreground="{DynamicResource SubTextBrush}" Content="Kopiraj sve" Click="CopyAllGlyphs_Click"/>
                                    <TextBlock Text="{Binding GlyphInfo}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="26,0,14,16">
                                    <ItemsControl ItemsSource="{Binding Glyphs}" FontFamily="{Binding SelectedFont.Family}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GlyphCell}" Content="{Binding Text}" ToolTip="{Binding Code}"
                                                        Click="Glyph_Click"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- Tester -->
                            <Grid Grid.Row="2" Visibility="{Binding ShowTester, Converter={StaticResource BoolVis}}">
                                <wv2:WebView2 x:Name="TesterView" Margin="2,6,0,0"/>
                                <TextBlock x:Name="TesterMessage" Margin="26" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Obavijest (toast) -->
                <Border x:Name="Toast" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                        Background="{DynamicResource ToastBrush}" CornerRadius="18" Padding="16,9,18,10" Opacity="0"
                        IsHitTestVisible="False" Effect="{StaticResource PopupShadow}" MaxWidth="640">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ToastSpinner" Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
